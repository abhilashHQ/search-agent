# MeowGle runs Claude through the Claude Code CLI, which `npm install` puts in node_modules.
# Give it ONE of these two. If both are set, the subscription token is used.

# 1. A Claude subscription (Pro, Max, Team). Run `npx claude setup-token`, sign in, paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
# 2. Or an Anthropic API key from console.anthropic.com.
ANTHROPIC_API_KEY=

# Web search. Free key at dashboard.exa.ai.
EXA_API_KEY=

# Optional below this line.

# A model alias (opus, sonnet, haiku) or a full model id.
CLAUDE_MODEL=claude-opus-5-5
# Default effort when the UI doesn't send one: low | medium | high
CLAUDE_EFFORT=low
# Config dir for the CLI, kept apart from your own ~/.claude. Defaults to data/claude-config.
CLAUDE_CONFIG_DIR=
# Path to a different claude binary than the bundled one.
CLAUDE_BIN=
PORT=3000
DB_PATH=data/meowgle.db
